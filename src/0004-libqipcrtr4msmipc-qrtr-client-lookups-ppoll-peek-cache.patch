-// TODO store on per-socket basis; for now we assume only one socket per program
-static uint32_t g_service = 0, g_instance = 0;
+#define MAX_SOCKET_STATES 32
+#define MAX_QMI_SERVICE 255
+#define MAX_PENDING_LOOKUP_REPLIES (MAX_QMI_SERVICE + 1)
+#define MAX_PEEKED_MESSAGE_SIZE 65536
+#define NO_QUEUED_DATAGRAM -2
+
+struct socket_state {
+	int in_use;
+	int lock_initialized;
+	int fd;
+	pthread_mutex_t lock;
+	uint32_t service;
+	uint32_t instance;
+	struct qrtr_ctrl_pkt pending[MAX_PENDING_LOOKUP_REPLIES];
+	size_t pending_head;
+	size_t pending_count;
+	unsigned char peeked[MAX_PEEKED_MESSAGE_SIZE];
+	ssize_t peeked_size;
+	struct sockaddr_qrtr peeked_source;
+};
+
+static pthread_mutex_t states_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct socket_state states[MAX_SOCKET_STATES];
+
+static struct socket_state *get_socket_state(int fd, int create)
+{
+	struct socket_state *free_state = NULL;
+	struct socket_state *state = NULL;
+
+	pthread_mutex_lock(&states_lock);
+	for (size_t i = 0; i < MAX_SOCKET_STATES; i++) {
+		if (states[i].in_use && states[i].fd == fd) {
+			state = &states[i];
+			break;
+		}
+		if (!states[i].in_use && !free_state)
+			free_state = &states[i];
+	}
+
+	if (!state && create && free_state) {
+		state = free_state;
+		state->in_use = 1;
+		state->fd = fd;
+		if (!state->lock_initialized) {
+			pthread_mutex_init(&state->lock, NULL);
+			state->lock_initialized = 1;
+		}
+	}
+	pthread_mutex_unlock(&states_lock);
+	return state;
+}
+
+/*
+ * AF_MSM_IPC has no QRTR nameserver socket. Client lookups are therefore
+ * answered from IPC_ROUTER_IOCTL_LOOKUP_SERVER and queued as synthetic QRTR
+ * control packets on the requesting socket.
+ */
 
 /* intercepted functions */
 int socket(int domain, int type, int protocol) {
-	return real_socket(domain != AF_QIPCRTR ? domain : AF_MSM_IPC, type, protocol);
+	int fd = real_socket(domain != AF_QIPCRTR ? domain : AF_MSM_IPC, type, protocol);
+
+	if (fd >= 0 && domain == AF_QIPCRTR)
+		get_socket_state(fd, 1);
+	return fd;
 }
 
